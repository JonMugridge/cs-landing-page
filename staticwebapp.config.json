{
  "routes": [
    { "route": "/login.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/assets/*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/logout", "redirect": "/.auth/logout?post_logout_redirect_uri=/login.html" },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/login.html", "statusCode": 302 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  }
}
